@page "/"
@inject BrowserDbContext Db

<PageTitle>VibeLang — learn a language</PageTitle>

<section class="hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge bg-light text-dark mb-2">Browser demo · no server</span>
            <h1 class="display-5 mb-3">Learn a language.<br />Keep the streak.</h1>
            <p class="lead mb-4">
                Courses, lessons, vocabulary and achievements — running entirely in this tab
                with the real VibeLang data model and EF Core SQLite.
            </p>
            <a class="btn btn-light btn-lg" href="courses">Browse courses</a>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <img src="assets/icons/vibelang_transparent_1024.png" alt="VibeLang" style="max-height:180px" />
        </div>
    </div>
</section>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h2 class="h4 mb-0">Courses</h2>
        <div class="text-muted small">@courses.Count available</div>
    </div>
    <a href="courses" class="small">See all</a>
</div>

<div class="row g-3">
    @foreach (var course in courses)
    {
        <div class="col-md-6 col-lg-4">
            <div class="course-card p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge badge-soft">@course.IsoCode.ToUpperInvariant()</span>
                    <span class="text-muted small">@course.Chapters.Count chapters</span>
                </div>
                <h3 class="h5 mt-2">@course.Title</h3>
                <p class="text-muted small mb-3">@course.Description</p>
                <a class="btn btn-sm btn-primary" href="courses/@course.Id">Open course</a>
            </div>
        </div>
    }
</div>

@code {
    private List<Course> courses = new();

    protected override async Task OnInitializedAsync()
    {
        courses = await Db.Courses.AsNoTracking()
            .Include(c => c.Chapters)
            .OrderBy(c => c.Id)
            .ToListAsync();
    }
}
