@page "/forgot-password"
<PageTitle>Forgot Password</PageTitle>

<div class="auth-page-wrapper">
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-icon-wrapper"><span class="auth-icon">✉️</span></div>
            <h1 class="auth-title">Forgot Password</h1>
            <p class="auth-subtitle">Password reset needs an email server</p>
        </div>
        <div class="auth-form-body">
            <div class="alert alert-info">
                This static demo has no email service, so password reset is not available.
                Use one of the demo accounts on the sign-in page, or register a new account.
            </div>
            <a href="login" class="btn btn-primary w-100 rounded-pill">Back to Sign In</a>
        </div>
    </div>
</div>
