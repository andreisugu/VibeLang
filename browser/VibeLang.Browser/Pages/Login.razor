@page "/login"
@using System.ComponentModel.DataAnnotations
@inject BrowserAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Sign In</PageTitle>

<div class="auth-page-wrapper">
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-icon-wrapper"><span class="auth-icon">🌟</span></div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to continue learning</p>
        </div>

        <EditForm Model="model" OnValidSubmit="Submit">
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="auth-error-summary" role="alert">@error</div>
            }

            <div class="auth-form-body">
                <div class="auth-field">
                    <label class="auth-label">Email Address</label>
                    <div class="auth-input-wrapper">
                        <span class="auth-input-icon">✉️</span>
                        <InputText @bind-Value="model.Email" id="email" class="auth-input" autocomplete="username" placeholder="your@email.com" />
                    </div>
                </div>

                <div class="auth-field">
                    <div class="auth-label-row">
                        <label class="auth-label">Password</label>
                        <a id="forgotPasswordLink" href="forgot-password" class="auth-forgot-link">Forgot password?</a>
                    </div>
                    <div class="auth-input-wrapper">
                        <span class="auth-input-icon">🔒</span>
                        <input @bind="model.Password" id="password" type="password" class="auth-input" autocomplete="current-password" placeholder="Enter your password" />
                        <button type="button" class="auth-toggle-password" @onclick="TogglePassword" aria-label="Show or hide password"><span>👁️</span></button>
                    </div>
                </div>

                <div class="auth-remember-row">
                    <label class="auth-checkbox-label">
                        <InputCheckbox @bind-Value="model.RememberMe" class="auth-checkbox" />
                        <span class="auth-checkbox-text">Remember me on this device</span>
                    </label>
                </div>

                <button id="loginSubmit" type="submit" class="auth-submit-btn">
                    <span class="auth-btn-text">Sign In</span>
                    <span class="auth-btn-icon">→</span>
                </button>

                <p class="text-muted small mt-3 mb-0">
                    Demo accounts: <code>student@vibelang.com / Student123</code> ·
                    admin <code>admin@vibelang.com / Admin123</code>
                </p>
            </div>
        </EditForm>

        <div class="auth-card-footer">
            <p class="auth-footer-text">
                Don't have an account?
                <a id="registerLink" href="register" class="auth-link">Sign up for free</a>
            </p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private LoginModel model = new();
    private string? error;

    private async Task Submit()
    {
        error = null;
        if (await Auth.LoginAsync(model.Email, model.Password))
        {
            Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "" : ReturnUrl!);
        }
        else
        {
            error = "Invalid email or password.";
        }
    }

    private async Task TogglePassword() => await JS.InvokeVoidAsync("vibelangTogglePassword", "password");

    public sealed class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "student@vibelang.com";
        [Required] public string Password { get; set; } = "Student123";
        public bool RememberMe { get; set; } = true;
    }
}
