@page "/vocabulary"
@inject BrowserDbContext Db
@inject ProgressService Progress

<PageTitle>Mastered Vocabulary</PageTitle>

<h1 class="h4">Mastered Vocabulary</h1>
<p class="text-muted">Every word in the demo. Words from completed lessons are marked as learned.</p>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4">Word</th>
                    <th>Translation</th>
                    <th>Example</th>
                    <th>Lesson</th>
                    <th class="text-end px-4">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var word in words)
                {
                    var learned = completed.Contains(word.LessonId);
                    <tr>
                        <td class="px-4 fw-semibold">@word.Word</td>
                        <td>@word.Translation</td>
                        <td class="text-muted small">@word.ExampleSentence</td>
                        <td class="small">@word.Lesson?.Title</td>
                        <td class="text-end px-4">
                            @if (learned)
                            {
                                <span class="badge bg-success">Learned</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">New</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<VocabularyWord> words = new();
    private HashSet<int> completed = new();

    protected override async Task OnInitializedAsync()
    {
        var progress = await Progress.GetAsync();
        completed = progress.Lessons.ToHashSet();
        words = await Db.VocabularyWords.AsNoTracking()
            .Include(w => w.Lesson)
            .OrderBy(w => w.LessonId).ThenBy(w => w.Id)
            .ToListAsync();
    }
}
