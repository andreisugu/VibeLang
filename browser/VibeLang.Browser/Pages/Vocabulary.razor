@page "/vocabulary"
@inject IVocabularyService Vocab
@inject BrowserAuthService Auth
@inject NavigationManager Nav

<PageTitle>Vocabulary</PageTitle>

<h1 class="h4">Vocabulary</h1>

@if (loading)
{
    <p class="text-muted">Loading your vocabulary…</p>
}
else if (words.Count == 0)
{
    <div class="alert alert-info">
        Complete some lessons to build your vocabulary! Your learned words will appear here.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0"><div class="card-body">
                <h2 class="text-primary display-6 mb-0">@stats.Total</h2><div class="text-muted small">Total Words</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0"><div class="card-body">
                <h2 class="text-success display-6 mb-0">@stats.Learned</h2><div class="text-muted small">Learned</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0"><div class="card-body">
                <h2 class="text-info display-6 mb-0">@stats.Mastered</h2><div class="text-muted small">Mastered</div>
            </div></div>
        </div>
    </div>

    <ul id="vocabulary-list" class="list-group">
        @foreach (var word in words)
        {
            var status = progress.TryGetValue(word.Id, out var s) ? s : "New";
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@word.Word</strong>
                    <span class="text-muted ms-2">- @word.Translation</span>
                    @if (!string.IsNullOrWhiteSpace(word.ExampleSentence))
                    {
                        <div class="small fst-italic text-muted">@word.ExampleSentence</div>
                    }
                </div>
                <span class="badge @(status == "Learned" || status == "Mastered" ? "bg-success" : "bg-secondary")">@status</span>
            </li>
        }
    </ul>
}

@code {
    private bool loading = true;
    private List<VocabularyWord> words = new();
    private Dictionary<int, string> progress = new();
    private (int Total, int Learned, int Mastered) stats;

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo("login?returnUrl=vocabulary");
            return;
        }

        words = (await Vocab.GetUserVocabularyAsync(user.Id)).ToList();
        progress = await Vocab.GetUserVocabularyProgressAsync(user.Id);
        stats = await Vocab.GetUserVocabularyStatsAsync(user.Id);
        loading = false;
    }
}
