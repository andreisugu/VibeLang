@page "/courses"
@inject VibeLangDbContext Db
@inject BrowserAuthService Auth
@inject NavigationManager Nav

<PageTitle>Courses</PageTitle>

@if (loading)
{
    <p class="text-muted">Loading your learning paths…</p>
}
else
{
    <h1 class="h4">Your Learning Paths</h1>
    <a href="vocabulary" class="btn btn-link p-0 mb-3">Mastered Vocabulary</a>

    <div class="row mt-4">
        @if (courses.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">No courses available. Start by adding a Language and a Course!</div>
            </div>
        }
        else
        {
            @foreach (var course in courses)
            {
                var lessons = course.Chapters.SelectMany(ch => ch.Lessons).ToList();
                var coursePercent = lessons.Count > 0 ? (int)((double)lessons.Count(l => completed.Contains(l.Id)) / lessons.Count * 100) : 0;

                <div class="col-12 mb-5">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                            <h2 class="h5 mb-0">@course.Title</h2>
                            <span class="badge bg-white text-primary rounded-pill">@coursePercent% Complete</span>
                        </div>
                        <div class="card-body bg-light">
                            <div class="progress mb-4" style="height: 10px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @coursePercent%;"></div>
                            </div>

                            @if (!course.Chapters.Any())
                            {
                                <p class="text-muted fst-italic">This course is coming soon...</p>
                            }
                            else
                            {
                                <div class="row">
                                    @foreach (var chapter in course.Chapters.OrderBy(c => c.Order))
                                    {
                                        var chapterLessons = chapter.Lessons.ToList();
                                        var chapterPercent = chapterLessons.Count > 0 ? (int)((double)chapterLessons.Count(l => completed.Contains(l.Id)) / chapterLessons.Count * 100) : 0;

                                        <div class="col-md-6 mb-4">
                                            <div class="card h-100 border-0 shadow-sm">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                                        <h3 class="h6 text-uppercase fw-bold text-muted mb-0">@chapter.Title</h3>
                                                        <small class="text-primary fw-bold">@chapterPercent%</small>
                                                    </div>

                                                    <div class="progress mb-3" style="height: 5px;">
                                                        <div class="progress-bar bg-info" role="progressbar" style="width: @chapterPercent%;"></div>
                                                    </div>

                                                    <div class="list-group list-group-flush">
                                                        @foreach (var lesson in chapterLessons.OrderBy(l => l.Order))
                                                        {
                                                            var isDone = completed.Contains(lesson.Id);
                                                            <a href="lessons/@lesson.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-0">
                                                                <span>
                                                                    <i class="bi @(isDone ? "bi-check-circle-fill text-success" : "bi-play-circle-fill text-primary") me-2"></i>
                                                                    @lesson.Title
                                                                </span>
                                                                @if (isDone)
                                                                {
                                                                    <span class="badge bg-success-soft text-success rounded-pill small">Done</span>
                                                                }
                                                            </a>
                                                        }
                                                        @if (!chapterLessons.Any())
                                                        {
                                                            <div class="text-muted small">No lessons yet.</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private bool loading = true;
    private List<Course> courses = new();
    private HashSet<int> completed = new();

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo("login?returnUrl=courses");
            return;
        }

        completed = (await Db.UserLessonProgresses.AsNoTracking()
            .Where(p => p.UserId == user.Id && p.IsCompleted)
            .Select(p => p.LessonId).ToListAsync()).ToHashSet();

        courses = await Db.Courses.AsNoTracking()
            .Include(c => c.Chapters).ThenInclude(ch => ch.Lessons)
            .OrderBy(c => c.Id)
            .ToListAsync();

        loading = false;
    }
}
