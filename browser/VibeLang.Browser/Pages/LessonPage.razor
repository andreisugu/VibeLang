@page "/lessons/{Id:int}"
@implements IDisposable
@inject VibeLangDbContext Db
@inject BrowserAuthService Auth
@inject LessonResultService LessonResults
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Lesson: @(lesson?.Title ?? "Loading...")</PageTitle>

<div class="container py-4">
    <div id="quiz-container" class="mx-auto" style="max-width: 700px;">
        @if (lesson is null)
        {
            <div class="alert alert-info">No lesson found.</div>
        }
        else if (string.IsNullOrWhiteSpace(contentJson))
        {
            <div class="alert alert-info">This lesson has no interactive content yet.</div>
            <a href="courses" class="btn btn-primary rounded-pill px-5">Back to Courses</a>
        }
        else
        {
            <div class="progress mb-4" style="height: 10px;">
                <div id="quiz-progress" class="progress-bar bg-success" role="progressbar" style="width: 0%;"></div>
            </div>

            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div id="question-header" class="mb-4">
                        <h2 id="question-text" class="h4 fw-bold">Loading question...</h2>
                        <div id="question-hint" class="text-muted small"></div>
                    </div>

                    <div id="question-content" class="mb-4"></div>

                    <div id="feedback-area" class="mb-4 d-none">
                        <div id="feedback-message" class="alert p-3 mb-0"></div>
                    </div>

                    <div id="quiz-controls" class="d-flex gap-2">
                        <button id="btn-check" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">Check</button>
                        <button id="btn-next" class="btn btn-success rounded-pill px-5 py-2 fw-bold d-none">Continue</button>
                        <button id="btn-skip" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-none">Skip</button>
                    </div>
                </div>
            </div>

            <div id="results-view" class="card shadow-sm border-0 d-none">
                <div class="card-body p-5 text-center">
                    <div class="display-1 text-success mb-3"><i class="bi bi-trophy-fill"></i></div>
                    <h2 class="fw-bold mb-3">Lesson Complete!</h2>
                    <p class="text-muted mb-4">You've finished this lesson. Here's how you did:</p>

                    <div class="row justify-content-center mb-4">
                        <div class="col-6 col-md-4">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <div class="h3 mb-0 fw-bold text-primary" id="final-score">0</div>
                                <div class="small text-muted">Total Score</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <div class="h3 mb-0 fw-bold text-success" id="xp-earned">+0</div>
                                <div class="small text-muted">XP Earned</div>
                            </div>
                        </div>
                    </div>

                    <a href="courses" class="btn btn-primary rounded-pill px-5">Back to Courses</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Lesson? lesson;
    private string? contentJson;
    private bool started;
    private DotNetObjectReference<LessonPage>? selfRef;

    protected override async Task OnParametersSetAsync()
    {
        var user = await Auth.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo($"login?returnUrl=lessons/{Id}");
            return;
        }

        lesson = await Db.Lessons.AsNoTracking().FirstOrDefaultAsync(l => l.Id == Id);
        contentJson = lesson?.ContentJson?.Replace("\\'", "'");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!started && lesson is not null && !string.IsNullOrWhiteSpace(contentJson))
        {
            started = true;
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vibelangRegisterSubmit", selfRef);
            await JS.InvokeVoidAsync("vibelangStartLesson", contentJson, lesson.Id);
        }
    }

    [JSInvokable]
    public async Task<object> SubmitLesson(int lessonId, int score)
    {
        var result = await LessonResults.SubmitAsync(lessonId, score);
        return new { success = result.Ok, xpAdded = result.XpAdded, totalXP = result.TotalXp };
    }

    public void Dispose()
    {
        selfRef?.Dispose();
    }
}
