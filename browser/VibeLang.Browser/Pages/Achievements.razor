@page "/achievements"
@inject VibeLangDbContext Db
@inject BrowserAuthService Auth
@inject IAchievementService AchievementSvc
@inject NavigationManager Nav

<PageTitle>Achievements</PageTitle>

<div class="container py-5">
    <h1 class="mb-2">Achievements</h1>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-primary display-4">@totalEarned</h2>
                    <p class="text-muted mb-0">Achievements Earned</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-info display-4">@totalAvailable</h2>
                    <p class="text-muted mb-0">Total Available</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-success display-4">@percentage%</h2>
                    <p class="text-muted mb-0">Completion</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between mb-2">
            <span class="fw-bold">Achievement Progress</span>
            <span class="text-muted">@totalEarned / @totalAvailable</span>
        </div>
        <div class="progress" style="height: 25px;">
            <div class="progress-bar bg-success" role="progressbar" style="width: @percentage%;" aria-valuenow="@totalEarned" aria-valuemin="0" aria-valuemax="@totalAvailable">@percentage%</div>
        </div>
    </div>

    <h3 class="mb-4">All Achievements</h3>
    <div class="row g-4 achievements-grid">
        @foreach (var achievement in achievements)
        {
            var isEarned = earned.TryGetValue(achievement.Id, out var earnedDate);
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 @(isEarned ? "border-success" : "opacity-75")">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            @if (isEarned)
                            {
                                <div class="display-1">@Icon(achievement.Title)</div>
                            }
                            else
                            {
                                <div class="display-1 text-muted">🔒</div>
                            }
                        </div>

                        <h5 class="card-title fw-bold">@achievement.Title</h5>
                        <p class="card-text text-muted small">@achievement.Description</p>

                        @if (isEarned)
                        {
                            <span class="badge bg-success mb-3">✓ Earned</span>
                            <p class="text-muted small mb-0">Earned on @earnedDate.ToString("MMM dd, yyyy")</p>
                        }
                        else
                        {
                            <span class="badge bg-secondary mb-3">Locked</span>
                            <p class="text-muted small mb-0">Complete more lessons to unlock</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (achievements.Count == 0)
    {
        <div class="alert alert-info text-center" role="alert">No achievements available yet. Check back soon!</div>
    }
</div>

@code {
    private List<Achievement> achievements = new();
    private Dictionary<int, DateTime> earned = new();

    private int totalEarned => earned.Count;
    private int totalAvailable => achievements.Count;
    private int percentage => totalAvailable > 0 ? totalEarned * 100 / totalAvailable : 0;

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo("login?returnUrl=achievements");
            return;
        }

        achievements = await Db.Achievements.AsNoTracking().OrderBy(a => a.Id).ToListAsync();
        earned = await AchievementSvc.GetUserAchievementsAsync(user.Id);
    }

    private static string Icon(string title) =>
        title.Contains("Beginner") ? "🎯" :
        title.Contains("Expert") ? "⭐" :
        title.Contains("Speed") ? "⚡" :
        title.Contains("Perfect") ? "💯" :
        title.Contains("Marathon") ? "🏃" :
        title.Contains("Social") ? "👥" : "🏆";
}
