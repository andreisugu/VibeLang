@implements IDisposable
@inject DemoSession Session
@inject NavigationManager Nav

<ul class="navbar-nav align-items-center flex-row gap-2 mb-0">
    @if (Session.IsSignedIn)
    {
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 text-dark" href="profile" title="My Profile">
                <span class="avatar-initials rounded-circle d-inline-flex align-items-center justify-content-center text-white fw-bold">@Initial</span>
                <span class="d-none d-md-inline">@Session.Name</span>
            </a>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link text-dark border-0" @onclick="SignOut">Logout</button>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link text-dark" href="login">Register</a></li>
        <li class="nav-item"><a class="nav-link text-dark" href="login">Login</a></li>
    }
</ul>

@code {
    private string Initial => Session.Name.Length > 0 ? Session.Name[0].ToString().ToUpperInvariant() : "?";

    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOut()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("");
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
