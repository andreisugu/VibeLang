@inherits LayoutComponentBase

<div class="page">
    <header class="navbar navbar-expand bg-white border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="">
                <img src="assets/icons/vibelang_transparent_1024.png" class="brand-logo" alt="" />
                <span class="fw-bold">VibeLang</span>
            </a>
            <NavMenu />
        </div>
    </header>

    <main class="container py-4">
        @Body
    </main>

    <footer class="container py-4 border-top mt-4">
        <div class="d-flex justify-content-between flex-wrap gap-2">
            <span>Browser demo — real C# + EF Core SQLite running in this tab. No server.</span>
            <a href="https://github.com/andreisugu/VibeLang" target="_blank" rel="noreferrer">Source</a>
        </div>
    </footer>
</div>
