@inherits LayoutComponentBase
@inject BrowserAuthService Auth

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-light bg-light px-3">
        <a class="navbar-brand me-3" href="">
            <img src="assets/icons/vibelang_transparent_1024.png" alt="VibeLang" class="navbar-logo" style="height: 40px;">
            <span class="vibelang-title">VibeLang</span>
        </a>
        <a class="nav-link mx-2" href="courses">Courses</a>
        <a class="nav-link mx-2" href="leaderboard">Leaderboard</a>
        <a class="nav-link mx-2" href="achievements">Achievements</a>
        <div class="ms-auto">
            <NavMenu />
        </div>
    </nav>

    <main role="main" class="container my-4">
        @Body
    </main>

    <footer class="bg-light text-center py-3 mt-auto border-top">
        <div class="mb-2">&copy; 2026 - VibeLang</div>
        <a class="nav-link text-danger fw-bold" href="admin">Admin Panel</a>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
    }
}
