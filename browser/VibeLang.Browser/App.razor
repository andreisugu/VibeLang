<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(VibeLang.Browser.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(VibeLang.Browser.Layout.MainLayout)">
            <p role="alert" class="text-muted">There is nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
